# 복사해서 .env.local을 만들고 값을 채운다. 값은 이 파일에 적지 않는다.
# 모두 서버 전용이다. NEXT_PUBLIC_ 접두사를 쓰지 않는다.
# v2는 DB(Supabase)와 로그인이 없다. 유료 기능의 문지기(Turnstile·이용권) 설정은 4단계에서 더한다.

# 음성→문자, 읽어주기
OPENAI_API_KEY=
STT_MODEL=
TTS_MODEL=
TTS_VOICE=
# 증권 읽기: openai 또는 anthropic
VISION_PROVIDER=
VISION_MODEL=
ANTHROPIC_API_KEY=
# 사고 내용에서 사실 추출, 쉬운 말 설명
LLM_PROVIDER=
LLM_MODEL=
# 국가법령정보센터 Open API 인증값(OC). open.law.go.kr에서 신청하고, 서버의 IP·도메인을 등록해야 응답이 온다.
# 비어 있으면 화면에 "법령 정보를 불러오지 못했습니다"만 나온다.
LAW_API_OC=
