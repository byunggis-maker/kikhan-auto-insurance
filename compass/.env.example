# 복사해서 .env.local을 만들고 값을 채운다. 값은 이 파일에 적지 않는다.
# 모두 서버 전용이다. NEXT_PUBLIC_ 접두사를 쓰지 않는다.
# v2는 DB(Supabase)와 로그인이 없다.
#
# ── 자동 기능을 켜는 데 꼭 필요한 것 ──
# GUARD_SECRET이 비면 /api/guard/config가 enabled:false를 돌려주고 화면에 "준비 중입니다"가 나온다.
#   증권 자동 읽기: VISION_PROVIDER(openai|anthropic), VISION_MODEL, 그리고 고른 쪽의 OPENAI_API_KEY 또는 ANTHROPIC_API_KEY
#   음성을 글로 바꾸기: OPENAI_API_KEY, STT_MODEL
#   사고 사실 뽑기·쉬운 말 설명: LLM_PROVIDER, LLM_MODEL
# ── 있으면 보호가 강해지는 것(없어도 동작하는 간이 모드) ──
#   TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY: 없으면 이용권 발급 때 봇 확인을 건너뛴다.
#   UPSTASH_REDIS_REST_URL·TOKEN(또는 KV_REST_API_URL·TOKEN): 배포에서 없으면 서버 메모리 카운터를 쓰고
#   IP당 하루 30회로 막는다(인스턴스마다 따로 세므로 약하다). 넣으면 원래 이용권 카운터로 돌아간다.
# 실제 배포(Production)에 Turnstile 시험용 키(1x0000…AA)를 넣으면 유료 기능이 막힌다.
# 긴 녹음은 60초씩 나눠 보내므로 1조각이 음성 변환 1번으로 센다. 길게 받으려면 TICKET_CALL_LIMITS의 stt를 늘린다(예: stt=15).

# 유료 기능 문지기(lib/guard). GUARD_SECRET이 없으면 유료 기능은 막히고 직접 입력·계산만 된다.
# 이용권 서명용 비밀값(32자 이상 임의값)
GUARD_SECRET=
# Cloudflare Turnstile. 사이트 키는 공개값이지만 서버가 화면에 넘긴다. 로컬 시험에는 Cloudflare의 시험용 키를 쓴다.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 이용권·사용량 카운터(Upstash Redis). Vercel 마켓플레이스로 붙이면 KV_REST_API_URL·KV_REST_API_TOKEN이 생기며, 그 이름도 읽는다.
# 비어 있으면 메모리 카운터를 쓴다(Vercel에서는 간이 모드: IP당 하루 30회).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 하루 이용권 수(IP당, 기본 3, 0이면 유료 기능 막음), 이용권 유효 시간(분, 기본 120)
DAILY_TICKET_LIMIT=
TICKET_TTL_MINUTES=
# 이용권 1장의 경로별 횟수. 비우면 policy-read=3,stt=5,extract=5,explain=10,tts=10
TICKET_CALL_LIMITS=
# 로컬 개발 전용: 이 파일에 적은 밀리초만큼 서버 시계를 옮긴다("다음 날" 시험). Upstash·Vercel에서는 쓰지 않는다.
GUARD_DEV_CLOCK_FILE=


# 음성→문자, 읽어주기
OPENAI_API_KEY=
STT_MODEL=
TTS_MODEL=
TTS_VOICE=
# 증권 읽기: openai 또는 anthropic
VISION_PROVIDER=
VISION_MODEL=
ANTHROPIC_API_KEY=
# 사고 내용에서 사실 추출, 쉬운 말 설명
LLM_PROVIDER=
LLM_MODEL=
# 국가법령정보센터 Open API 인증값(OC). open.law.go.kr에서 신청하고, 서버의 IP·도메인을 등록해야 응답이 온다.
# 비어 있으면 화면에 "법령 정보를 불러오지 못했습니다"만 나온다.
LAW_API_OC=
